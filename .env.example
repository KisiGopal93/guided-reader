# Guided Reader - Environment Configuration
#
# 1. Create a free Gemini API key in Google AI Studio:
#    https://aistudio.google.com/apikey
# 2. Copy this file to ".env" in the same folder:
#    cp .env.example .env   (or on Windows PowerShell: Copy-Item .env.example .env)
# 3. Replace the placeholder below with your own API key (never commit .env).

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default Gemini model if needed
# GEMINI_MODEL=gemini-flash-latest
